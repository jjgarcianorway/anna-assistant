name: Release

on:
  push:
    tags:
      - 'v*.*.*'

env:
  CARGO_TERM_COLOR: always

jobs:
  # Validate tag matches version
  validate-tag:
    name: Validate Tag
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.extract.outputs.version }}
    steps:
      - uses: actions/checkout@v4

      - name: Extract version from tag
        id: extract
        run: |
          TAG="${GITHUB_REF#refs/tags/}"
          VERSION="${TAG#v}"
          echo "Tag: $TAG"
          echo "Version: $VERSION"
          echo "version=$VERSION" >> $GITHUB_OUTPUT

      - name: Verify tag matches Cargo.toml version
        run: |
          TAG="${GITHUB_REF#refs/tags/}"
          VERSION="${TAG#v}"
          CARGO_VERSION=$(grep '^version = ' Cargo.toml | head -1 | sed 's/version = "\([^"]*\)"/\1/')

          if [ "$VERSION" != "$CARGO_VERSION" ]; then
            echo "ERROR: Tag version ($VERSION) does not match Cargo.toml version ($CARGO_VERSION)"
            exit 1
          fi
          echo "OK: Tag matches Cargo.toml version"

      - name: Verify tag matches VERSION file
        run: |
          TAG="${GITHUB_REF#refs/tags/}"
          VERSION="${TAG#v}"
          FILE_VERSION=$(cat VERSION | tr -d '[:space:]')

          if [ "$VERSION" != "$FILE_VERSION" ]; then
            echo "ERROR: Tag version ($VERSION) does not match VERSION file ($FILE_VERSION)"
            exit 1
          fi
          echo "OK: Tag matches VERSION file"

      - name: Verify CHANGELOG has entry for this version
        run: |
          TAG="${GITHUB_REF#refs/tags/}"
          VERSION="${TAG#v}"

          if ! grep -q "## \[$VERSION\]" CHANGELOG.md; then
            echo "ERROR: CHANGELOG.md missing entry for version $VERSION"
            echo "Add a section '## [$VERSION] - YYYY-MM-DD' to CHANGELOG.md"
            exit 1
          fi
          echo "OK: CHANGELOG has entry for $VERSION"

  # Run tests
  test:
    name: Test
    runs-on: ubuntu-latest
    needs: validate-tag
    steps:
      - uses: actions/checkout@v4

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Cache cargo
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/bin/
            ~/.cargo/registry/index/
            ~/.cargo/registry/cache/
            ~/.cargo/git/db/
            target/
          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}

      - name: Run tests
        run: cargo test --workspace

  # Build release artifacts
  build:
    name: Build
    runs-on: ubuntu-latest
    needs: [validate-tag, test]
    steps:
      - uses: actions/checkout@v4

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Cache cargo
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/bin/
            ~/.cargo/registry/index/
            ~/.cargo/registry/cache/
            ~/.cargo/git/db/
            target/
          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}

      - name: Build release binaries
        run: cargo build --release --workspace

      - name: Prepare artifacts
        run: |
          mkdir -p artifacts
          cp target/release/annad artifacts/annad-linux-x86_64
          cp target/release/annactl artifacts/annactl-linux-x86_64
          chmod +x artifacts/annad-linux-x86_64
          chmod +x artifacts/annactl-linux-x86_64

      - name: Generate SHA256SUMS
        working-directory: artifacts
        run: |
          sha256sum annad-linux-x86_64 annactl-linux-x86_64 > SHA256SUMS
          echo "SHA256SUMS contents:"
          cat SHA256SUMS

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: release-artifacts
          path: artifacts/
          retention-days: 1

  # Create GitHub release
  release:
    name: Release
    runs-on: ubuntu-latest
    needs: [validate-tag, build]
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4

      - name: Download artifacts
        uses: actions/download-artifact@v4
        with:
          name: release-artifacts
          path: artifacts

      - name: Extract release notes from CHANGELOG
        id: release-notes
        run: |
          VERSION="${{ needs.validate-tag.outputs.version }}"

          # Extract section for this version from CHANGELOG
          # Find the line with ## [$VERSION] and extract until next ## [
          awk -v ver="$VERSION" '
            /^## \[/ {
              if (found) exit
              if ($0 ~ "\\[" ver "\\]") found=1
            }
            found { print }
          ' CHANGELOG.md > release_notes.md

          echo "Release notes:"
          cat release_notes.md

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v1
        with:
          name: Anna v${{ needs.validate-tag.outputs.version }}
          body_path: release_notes.md
          files: |
            artifacts/annad-linux-x86_64
            artifacts/annactl-linux-x86_64
            artifacts/SHA256SUMS
          fail_on_unmatched_files: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Verify release assets
        run: |
          VERSION="${{ needs.validate-tag.outputs.version }}"
          TAG="v$VERSION"

          echo "Verifying release assets for $TAG..."

          # Give GitHub a moment to process the release
          sleep 5

          # Check release exists and has expected assets
          gh release view "$TAG" --json tagName,assets -q '.assets[].name' | sort > actual_assets.txt

          echo "Expected assets:"
          echo "SHA256SUMS"
          echo "annactl-linux-x86_64"
          echo "annad-linux-x86_64"

          echo ""
          echo "Actual assets:"
          cat actual_assets.txt

          # Verify all expected assets exist
          for asset in "SHA256SUMS" "annactl-linux-x86_64" "annad-linux-x86_64"; do
            if ! grep -q "^$asset$" actual_assets.txt; then
              echo "ERROR: Missing asset: $asset"
              exit 1
            fi
          done

          echo "OK: All expected assets present"
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
